# Gemini Pro API Key (Required for AI Analysis & Trading Signals)
GEMINI_API_KEY=your_gemini_pro_api_key_here

# Gemini Model Selection (default: gemini-1.5-pro or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-pro

# Kraken API Credentials (Required for Real Money Trading & Private Endpoints)
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_API_SECRET=your_kraken_api_secret_here

# App Configuration
PORT=3001
NODE_ENV=production
DEFAULT_TRADING_MODE=PAPER # Options: PAPER | REAL
DEFAULT_PAIR=XBTUSD
INITIAL_PAPER_BALANCE=10000
